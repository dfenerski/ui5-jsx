{
	"name": "com.df.ui5_jsx",
	"version": "1.0.0",
	"description": "I4110",
	"author": "Dimitar Fenerski",
	"license": "Apache-2.0",
	"types": "dist/index.d.ts",
	"files": [
		".eslintrc.js",
		"LICENCE",
		"README.md",
		"tsconfig.json",
		"ui5.yaml",
		"dist/**/*.d.ts",
		"dist/**/*.d.ts.map",
		"src",
		"test"
	],
	"scripts": {
		"clean": "rimraf dist coverage",
		"build": "ui5 build --clean-dest --exclude-task minify generateLibraryPreload",
		"build:ts-interfaces": "npx @ui5/ts-interface-generator",
		"start": "ui5 serve -o test-resources/com/df/ui5_jsx/Example.html",
		"start:dist": "npm start -- --config ui5-dist.yaml",
		"testsuite": "ui5 serve -o test-resources/com/df/ui5_jsx/qunit/testsuite.qunit.html",
		"ts-typecheck": "tsc --noEmit",
		"lint": "eslint src test",
		"karma": "karma start",
		"karma-ci": "karma start karma-ci.conf.js",
		"karma-ci-cov": "karma start karma-ci-cov.conf.js",
		"test": "npm run lint && npm run karma-ci-cov"
	},
	"devDependencies": {
		"@babel/plugin-proposal-decorators": "7.25.9",
		"@babel/preset-react": "^7.27.1",
		"@openui5/types": "1.140.0",
		"@sap-ux/vocabularies-types": "^0.13.0",
		"@ui5/cli": "^4.0.6",
		"@ui5/ts-interface-generator": "^0.8.3",
		"babel-plugin-transform-typescript-metadata": "^0.3.2",
		"eslint": "^9.9.1",
		"globals": "^15.9.0",
		"karma": "^6.4.4",
		"karma-chrome-launcher": "^3.2.0",
		"karma-coverage": "^2.2.1",
		"karma-ui5": "^4.0.1",
		"karma-ui5-transpile": "^3.4.8",
		"rimraf": "^6.0.1",
		"typescript": "^5.5.4",
		"typescript-eslint": "^8.3.0",
		"ui5-middleware-livereload": "^3.0.3",
		"ui5-tooling-modules": "^3.30.3",
		"ui5-tooling-transpile": "^3.4.8"
	}
}